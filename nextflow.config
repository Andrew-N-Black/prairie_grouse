// =============================================================================
// nextflow.config — nf-core/sarek v3.9.0
// Project : LEPC (Lesser Prairie-Chicken)
// Cluster : Purdue (SLURM, cpu partition, account fnrdewoody)
// =============================================================================

// ---------------------------------------------------------------------------
// Execution profiles
// ---------------------------------------------------------------------------
profiles {

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    slurm {
        process.executor       = 'slurm'
        process.clusterOptions = '--account=fnrdewoody --partition=cpu'
    }
}

// ---------------------------------------------------------------------------
// SLURM process resources
// Labels follow nf-core's standard tiers, used throughout sarek's modules.
// ---------------------------------------------------------------------------
process {
    executor       = 'slurm'
    clusterOptions = '--account=fnrdewoody --partition=cpu'
    time           = '14d'

    // Default
    cpus   = 2
    memory = '8.GB'

    withLabel: process_single {
        cpus   = 1
        memory = '6.GB'
        time   = '4h'
    }

    withLabel: process_low {
        cpus   = 2
        memory = '12.GB'
        time   = '8h'
    }

    // Trimming (fastp), BQSR, HaplotypeCaller
    withLabel: process_medium {
        cpus   = 6
        memory = '36.GB'
        time   = '1d'
    }

    // BWA-MEM2 alignment, joint genotyping
    withLabel: process_high {
        cpus   = 12
        memory = '72.GB'
        time   = '2d'
    }

    withLabel: process_high_memory {
        cpus   = 12
        memory = '128.GB'
        time   = '2d'
    }
}

// ---------------------------------------------------------------------------
// Singularity cache — store images in scratch to avoid re-pulling
// ---------------------------------------------------------------------------
singularity {
    cacheDir = "${System.getenv('CLUSTER_SCRATCH')}/singularity_cache"
}

// ---------------------------------------------------------------------------
// Nextflow work directory
// ---------------------------------------------------------------------------
workDir = "${System.getenv('CLUSTER_SCRATCH')}/LEPC/nf-work"

// ---------------------------------------------------------------------------
// Reports & logs
// ---------------------------------------------------------------------------
timeline {
    enabled   = true
    file      = "${System.getenv('CLUSTER_SCRATCH')}/LEPC/nf-out/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${System.getenv('CLUSTER_SCRATCH')}/LEPC/nf-out/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${System.getenv('CLUSTER_SCRATCH')}/LEPC/nf-out/pipeline_info/trace.txt"
    overwrite = true
}
dag {
    enabled = true
    file    = "${System.getenv('CLUSTER_SCRATCH')}/LEPC/nf-out/pipeline_info/dag.svg"
}
